# ==================================================
# 🚀 Runtime
# ==================================================

NODE_ENV=development
APP_ENV=local

# ==================================================
# 🏷️ Service Identity
# ==================================================

SERVICE_NAME=auth-service
SERVICE_NAMESPACE=core
SERVICE_INSTANCE_ID=local-dev-1
SERVICE_VERSION=1.0.0

# ==================================================
# 🌐 Server
# ==================================================

PORT=8000
HOSTNAME=localhost
BASE_URL=http://localhost:8000

# ==================================================
# 🗄️ Database
# ==================================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev

# ==================================================
# 📋 Logger
# ==================================================

# trace | debug | info | warn | error | fatal | silent

LOGGER_LEVEL=debug

# pretty (development) | json (production)

LOG_FORMAT=pretty

# Comma separated redact paths

LOG_REDACT_KEYS=req.headers.authorization,req.headers.cookie,req.headers.x-api-key,*.password,*.token,*.secret,*.accessToken,*.refreshToken,*.creditCard,*.cvv,*.ssn,*.otp

# ==================================================
# 🔍 Request Tracing
# ==================================================

REQUEST_ID_HEADER=x-request-id
TRACE_ID_HEADER=x-trace-id

# ==================================================
# 📊 OpenTelemetry
# ==================================================

OTEL_ENABLED=false

# Local OTLP Collector

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# 0.0 - 1.0

OTEL_SAMPLING_RATIO=1

# ==================================================
# 🚨 Error Monitoring (Sentry)
# ==================================================

SENTRY_ENABLED=false
SENTRY_DSN=

# ==================================================
# ☁️ Infrastructure Metadata
# ==================================================

POD_NAME=local
AWS_REGION=ap-south-1

# ==================================================
# 🚢 Deployment Metadata
# ==================================================
COMMIT_SHA=local-dev
DEPLOYMENT_ID=local

# ==================================================
# 🔐 Authentication
# ==================================================

GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ==================================================
# 🎨 Frontend
# ==================================================

NEXT_PUBLIC_API_URL=http://localhost:8000/trpc
NEXT_PUBLIC_APP_URL=http://localhost:3000
