{
  "name": "trpc-monorepo",
  "private": true,
  "scripts": {
    "build": "dotenv -- turbo build",
    "dev": "dotenv -- turbo dev",
    "db:generate": "dotenv -- turbo db:generate",
    "db:migrate": "dotenv -- turbo db:migrate",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "tsc --noEmit",
    "check-types": "turbo run check-types",
    "infra:postgres": "docker compose -f infra/docker-compose.yml up -d",
    "infra:otel": "docker compose -f infra/otel.compose.yml up -d",
    "infra:postgres:down": "docker compose -f infra/docker-compose.yml down",
    "infra:otel:down": "docker compose -f infra/otel.compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
